# Optional cloud comparison. Keys are read on the server only.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
SPEECHSUPER_APP_KEY=
SPEECHSUPER_SECRET_KEY=
SPEECHSUPER_CORE_TYPE=cn.word.score
# Qwen's OpenAI-compatible audio endpoint (optional; billed by provider).
QWEN_API_KEY=
